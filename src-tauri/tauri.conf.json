{
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run compilar"
  },
  "bundle": {
    "active": true,
    "category": "Finance",
    "copyright": "Copyright © 2026 dimartz-tech. All rights reserved.",
    "targets": [
      "dmg"
    ],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256"
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "Gestor Financiero Personal y Corporativo",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "MiChelitos",
  "mainBinaryName": "MiChelitos",
  "version": "1.115.0",
  "identifier": "com.michelitos.desktop",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 780,
        "resizable": true,
        "title": "MiChelitos",
        "width": 1100,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; script-src-attr 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  }
}
