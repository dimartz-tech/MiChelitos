{
  // Compila el frontend: `src/js/**/*.ts` → `src/js/**/*.js`, junto a los
  // fuentes. Es lo que empaqueta Tauri (`distDir` es `src`); los `.js` están
  // en .gitignore porque son generados. Sin empaquetador ni dependencias de
  // producción: la salida son módulos ES y scripts clásicos normales.
  //
  // Estricto en todo: `strict` y `noImplicitAny`, sin archivos exentos. Hasta la
  // 1.65.0 había una segunda configuración (`tsconfig.estricto.json`) para los
  // archivos que ya no tenían deuda de tipos, mientras `ui.ts` llevaba la suya; al
  // retirarse `ui.ts` no quedó nada que exentar y se unificaron (ver
  // migracion_a_typescript.md).
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "src"
  },
  "include": ["src/js/**/*.ts"],
  // Explícito: por defecto `outDir` (aquí `src`) se excluye y no quedaría nada.
  "exclude": ["node_modules"]
}
